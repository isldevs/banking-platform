# Local environment template. scripts/setup-local.ps1 resolves placeholders into infrastructure/.env.
# infrastructure/.env is gitignored and is the local source of actual values.

# JWT / security
SECURITY_JWT_ISSUER=http://localhost:8081
SECURITY_JWT_AUDIENCE=api
SECURITY_JWT_KEYSTORE_PASSWORD=replace-with-strong-random-password
SECURITY_JWT_KEYSTORE_PATH=
SECURITY_JWT_PUBLIC_KEY_PATH=
SECURITY_JWT_KEYSTORE_ALIAS=jwt-signing
INTERNAL_SERVICE_KEY=replace-with-at-least-32-random-bytes
OAUTH2_DEMO_CLIENT_SECRET=replace-with-strong-random-client-secret

# Demo credentials (dev profile only)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-with-12-plus-character-password
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=replace-with-12-plus-character-password

# Direct local Gradle datasource configuration. Each service owns its own connection settings.
DB_AUTH_URL=jdbc:postgresql://localhost:5439/auth
DB_AUTH_USERNAME=auth_user
DB_AUTH_PASSWORD=replace-with-strong-password
DB_CUSTOMER_URL=jdbc:postgresql://localhost:5439/customer
DB_CUSTOMER_USERNAME=customer_user
DB_CUSTOMER_PASSWORD=replace-with-strong-password
DB_ACCOUNT_URL=jdbc:postgresql://localhost:5439/account
DB_ACCOUNT_USERNAME=account_user
DB_ACCOUNT_PASSWORD=replace-with-strong-password
DB_TRANSFER_URL=jdbc:postgresql://localhost:5439/transfer
DB_TRANSFER_USERNAME=transfer_user
DB_TRANSFER_PASSWORD=replace-with-strong-password
DB_NOTIFICATION_URL=jdbc:postgresql://localhost:5439/notification
DB_NOTIFICATION_USERNAME=notification_user
DB_NOTIFICATION_PASSWORD=replace-with-strong-password
DB_AUDIT_URL=jdbc:postgresql://localhost:5439/audit
DB_AUDIT_USERNAME=audit_user
DB_AUDIT_PASSWORD=replace-with-strong-password

# Database connection pool defaults. Override per environment based on measured workload and DB capacity.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=2000
DB_POOL_VALIDATION_TIMEOUT=1000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# Observability / tracing
# Keep OTLP export disabled for a local stack unless an OpenTelemetry Collector is running.
TRACING_OTLP_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# PostgreSQL bootstrap password retained for the local database environment.
POSTGRES_PASSWORD=replace-with-strong-password
DB_PASSWORD_AUTH=replace-with-strong-password
DB_PASSWORD_CUSTOMER=replace-with-strong-password
DB_PASSWORD_ACCOUNT=replace-with-strong-password
DB_PASSWORD_TRANSFER=replace-with-strong-password
DB_PASSWORD_NOTIFICATION=replace-with-strong-password
DB_PASSWORD_AUDIT=replace-with-strong-password

# Local messaging
SPRING_KAFKA_BOOTSTRAPSERVERS=localhost:29092

# Docker-only JWT issuer. Containers must not use localhost for auth-service discovery.
DOCKER_JWT_ISSUER=http://auth-service:8081
