# Template only. Prefer generating real local secrets with: bash infrastructure/scripts/init-local.sh
# Replace every placeholder before running Docker Compose.
JWT_ISSUER=http://localhost:8081
APP_UID=1000
APP_GID=1000
POSTGRES_PASSWORD=replace-with-strong-password
INTERNAL_SERVICE_KEY=replace-with-at-least-32-random-bytes
CONFIG_SERVER_USERNAME=config-client
CONFIG_SERVER_PASSWORD=replace-with-strong-random-password
CONFIG_REPO_LABEL=main
DEMO_ADMIN_PASSWORD=replace-with-12-plus-character-password
DEMO_USER_PASSWORD=replace-with-12-plus-character-password
DB_PASSWORD_AUTH=replace-with-strong-password
DB_PASSWORD_CUSTOMER=replace-with-strong-password
DB_PASSWORD_ACCOUNT=replace-with-strong-password
DB_PASSWORD_TRANSFER=replace-with-strong-password
DB_PASSWORD_NOTIFICATION=replace-with-strong-password
DB_PASSWORD_AUDIT=replace-with-strong-password
# Optional only for a private Git-backed Config repository:
# CONFIG_REPO_URI=https://github.com/owner/config-repo.git
# CONFIG_REPO_USERNAME=git-user
# CONFIG_REPO_PASSWORD=git-token
# CONFIG_REPO_SEARCH_PATHS=config-repo
